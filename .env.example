# Proyecto de Supabase (Configuración > API). Nunca subas el archivo .env.local al repositorio.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública de la aplicación, con https:// en producción. OBLIGATORIA en producción: con ella se
# arman los enlaces de invitación y de recuperación de contraseña, y es el origen permitido (CORS).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Otros orígenes propios que pueden enviar solicitudes a la aplicación (CORS), separados por comas.
# Déjalo vacío salvo que exista, por ejemplo, la sub-app de votación en otro dominio.
ORIGENES_PERMITIDOS=

# Límite de intentos compartido entre instancias (Upstash Redis, plan gratuito). Recomendado en
# producción. Sin estas variables el límite se cuenta en la memoria de cada instancia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CAPTCHA en ingreso y recuperación (opcional). Proveedor: turnstile o hcaptcha.
# Configura el mismo proveedor y su llave secreta en Supabase (Authentication > Bot and Abuse Protection).
# Si se dejan vacías, los formularios funcionan sin CAPTCHA.
NEXT_PUBLIC_CAPTCHA_PROVEEDOR=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# Solo para las pruebas de base de datos (PostgreSQL local o de CI).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
